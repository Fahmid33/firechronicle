# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://firechronicle.vercel.app"]

# Data Directory (relative to firechronicle-backend root or absolute)
DATA_DIR=data

# DuckDB Database File (:memory: or local db file)
DUCKDB_PATH=:memory:

# Remote Data Science ML Model API
ML_MODEL_API_URL=http://localhost:8001
ML_MODEL_API_KEY=firechronicle_ml_secret_key_2026
ML_MODEL_TIMEOUT_SECONDS=5.0

# Inbound Webhook / Sync API Key for Data Science pushes
WEBHOOK_API_KEY=firechronicle_webhook_sync_key_2026
