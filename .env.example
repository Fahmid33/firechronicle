# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed Frontend Origin(s) for CORS (never use "*")
FRONTEND_URL=http://localhost:3000

# Data Directory (relative to firechronicle-backend root or absolute)
DATA_DIR=data

# DuckDB Database File (:memory: or local db file)
DUCKDB_PATH=:memory:

# Remote Data Science ML Model API (provide actual secret in local .env, never commit real keys)
ML_MODEL_API_URL=
ML_MODEL_API_KEY=
ML_MODEL_TIMEOUT_SECONDS=5.0

# Inbound Webhook / Sync API Key for Data Science pushes (provide via environment)
WEBHOOK_API_KEY=
